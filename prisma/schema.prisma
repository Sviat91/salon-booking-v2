generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums replaced with String constants due to SQLite limitations

// Client identity = (phone + name) pair. Two people sharing the same phone
// (e.g. a couple) get separate User records. Email uniqueness for admin/master
// auth is enforced at the application level (register endpoint), not in DB.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?
  emailVerified DateTime?
  phone         String?
  password      String?
  passwordEncrypted String?
  image         String?
  role          String    @default("CLIENT")
  adminPermissions String? // JSON: {"clients":{"view":bool,"edit":bool,"delete":bool},"gdpr":{"view":bool,"withdraw":bool,"erase":bool}}
  isGuest       Boolean   @default(false)
  telegramChatId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  masterProfile MasterProfile?
  appointmentsAsClient Appointment[] @relation("ClientAppointments")
  appointmentsAsMaster Appointment[] @relation("MasterAppointments")
  schedules            Schedule[]    @relation("MasterSchedules")
  dateOverrides        DateOverride[] @relation("MasterDateOverrides")
  createdServices      Service[]     @relation("MasterCreatedServices")
  consentRecords       ConsentRecord[]
  passwordResetTokens  PasswordResetToken[]
  accounts             Account[]
  pages                Page[]
  createdDiscounts     Discount[]    @relation("MasterCreatedDiscounts")

  @@index([phone])
  @@index([email])
}

model MasterProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  avatarUrl       String?
  bio_pl          String?
  bio_en          String?
  bio_uk          String?
  specialties     String?  // Stored as JSON string or comma-separated
  showOnHomepage  Boolean  @default(true)
  color           String?  @default("#166534")
  footerBlock     String?  // JSON: {"type":"photoWidget"|"text","config":{...}} — single block shown at the bottom of this master's booking page

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterServices  MasterService[]
}

model Service {
  id          String   @id @default(cuid())
  name_pl     String
  name_en     String?
  name_uk     String?
  duration    Int      // Duration in minutes
  price       Float    // Default price (can be overridden per master)

  masterId    String?  // Null = created by Admin, filled = created by Master
  master      User?    @relation("MasterCreatedServices", fields: [masterId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments    Appointment[]
  masterServices  MasterService[]
  discountServices DiscountService[]
}

// Per-master service assignment with optional price override
model MasterService {
  id              String   @id @default(cuid())
  masterProfileId String
  serviceId       String
  priceOverride   Float?   // null = use Service.price default

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  masterProfile   MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([masterProfileId, serviceId])
}

// Percentage discount. masterId semantics mirror Service.masterId exactly:
// null = created by Admin (applies to any master), filled = created by that
// Master (applies only to their own bookings and their own offered services).
model Discount {
  id            String   @id @default(cuid())
  label         String   // Admin-facing only. Never parsed or interpreted.
  percent       Int      // 1..100, validated at the application layer

  masterId      String?  // Null = created by Admin, filled = created by Master
  master        User?    @relation("MasterCreatedDiscounts", fields: [masterId], references: [id], onDelete: Cascade)

  requiresCode  Boolean  @default(false)
  code          String?  @unique // normalized UPPERCASE; null unless requiresCode
  oncePerClient Boolean  @default(false)

  // Optional "happy hour" window. Both null/empty = not time-restricted.
  windowDays      String? // JSON int[], Schedule.dayOfWeek semantics (0=Sunday..6=Saturday)
  windowIntervals String? // JSON array, same shape as Schedule.intervals

  startDate     DateTime?
  endDate       DateTime?
  active        Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services      DiscountService[]
  redemptions   DiscountRedemption[]
  appointments  Appointment[]

  @@index([masterId, active])
}

// Empty set for a discount = "all services in that discount's scope".
model DiscountService {
  id         String @id @default(cuid())
  discountId String
  serviceId  String

  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([discountId, serviceId])
  @@index([serviceId])
}

// One row per appointment that actually used a discount. Enforces
// oncePerClient (by normalized E.164 phone) and is the future reporting source.
model DiscountRedemption {
  id            String   @id @default(cuid())
  discountId    String
  appointmentId String   @unique
  clientPhone   String?  // normalized E.164; null when no valid phone exists
  redeemedAt    DateTime @default(now())

  discount    Discount    @relation(fields: [discountId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([discountId, clientPhone])
}

model ConsentRecord {
  id                     String   @id @default(cuid())
  userId                 String?
  user                   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  phoneDigits            String
  email                  String?
  emailNormalized        String?
  fullName               String
  normalizedName         String

  consentDate            DateTime @default(now())
  ipHash                 String?
  consentPrivacyV10      Boolean
  consentTermsV10        Boolean
  consentNotificationsV10 Boolean

  consentWithdrawnDate   DateTime?
  withdrawalMethod       String?
  requestErasureDate     DateTime?
  erasureDate            DateTime?
  erasureMethod          String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([phoneDigits, normalizedName, consentDate])
  @@index([userId, consentDate])
}

model Schedule {
  id          String   @id @default(cuid())
  masterId    String
  dayOfWeek   Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  isDayOff    Boolean  @default(false)
  intervals   String   @default("[{\"start\":\"09:00\",\"end\":\"18:00\"}]") // JSON array

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  master      User     @relation("MasterSchedules", fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, dayOfWeek])
}

model Appointment {
  id          String   @id @default(cuid())
  clientId    String
  masterId    String
  serviceId   String
  date        DateTime // The date of the appointment
  startTime   String   // "10:00" format
  endTime     String   // "11:00" format
  status      String   @default("PENDING")
  notes       String?
  clientLanguage String @default("pl")

  // Price snapshot taken at creation time (AD-2). Null only for rows created
  // before the discounts feature; readers fall back to the live service price.
  discountId    String?
  originalPrice Float?   // MasterService.priceOverride ?? Service.price, at booking time
  finalPrice    Float?   // what is actually charged; == originalPrice when undiscounted

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      User     @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  master      User     @relation("MasterAppointments", fields: [masterId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id])
  discount           Discount?           @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountRedemption DiscountRedemption?
}

// Replaces DayOff model. Represents specific date overrides (day-off or custom intervals).
model DateOverride {
  id          String   @id @default(cuid())
  masterId    String
  date        DateTime // specific date of the override
  isDayOff    Boolean  @default(false)
  intervals   String   @default("[]") // JSON array of custom intervals if not day off

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  master      User     @relation("MasterDateOverrides", fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, date])
}

model TenantConfig {
  id              String   @id @default(cuid())
  brandName       String   @default("Salon Booking")
  primaryColor    String   @default("#FDE5C3")
  secondaryColor  String   @default("#FFF6E9")
  accentColor     String   @default("#FFBBBD")
  textColor       String   @default("#2B2B2B")
  mutedColor      String   @default("#6B6B6B")
  borderColor     String   @default("#E9E2D6")
  cardColor       String   @default("#FFFFFF")
  successColor    String   @default("#21A67A")
  errorColor      String   @default("#D84E4E")
  // Calendar colors
  availableSlotColor String   @default("#22c55e")
  dayOffColor        String   @default("#ef4444")
  workingHourStart   Int      @default(8)
  workingHourEnd     Int      @default(21)

  // Dark mode colors
  darkBgColor     String   @default("#9c6849")
  darkPrimaryColor String  @default("#FDE5C3")
  darkAccentColor String   @default("#FFBBBD")
  darkCardColor   String   @default("#2A2A2A")
  darkTextColor   String   @default("#FFFFFF")
  darkMutedColor  String   @default("#D0D0D0")
  darkBorderColor String   @default("#7A4F35")
  
  logoUrl         String?
  faviconUrl      String?
  
  darkLogoUrl     String?
  logoPositionX   Float    @default(0)
  logoPositionY   Float    @default(0)
  logoWidth       Int      @default(200)
  logoHeight      Int      @default(80)
  logoPages       String   @default("[\"home\",\"booking\"]")
  logoLayer       String   @default("above") // "above" = on top of content, "below" = behind content
  bgType          String   @default("solid")    // "solid" | "gradient" | "picture"
  bgImageUrl      String?
  bgGradientFrom  String   @default("#FDE5C3")
  bgGradientTo    String   @default("#FFF6E9")
  bgGradientAngle Int      @default(135)
  bgApplyToDark   Boolean  @default(true)
  logoFullscreen  Boolean  @default(false)
  darkBgType        String   @default("solid")
  darkBgImageUrl    String?
  darkBgGradientFrom String  @default("#9c6849")
  darkBgGradientTo  String   @default("#2A2A2A")
  darkBgGradientAngle Int    @default(135)

  // Salon contact / legal info — displayed on booking confirmation,
  // support page, terms, and privacy policy.
  salonAddress      String?           // e.g. "Sarmacka 4B/ lokal 106"
  salonCity         String?           // e.g. "02-972 Warszawa"
  salonPhone        String?           // e.g. "+48 789 894 948"
  salonEmail        String?           // e.g. "info@salon.pl"
  salonCompanyName  String?           // Legal entity name
  salonNip          String?           // Tax ID (NIP)
  salonLegalAddress String?           // Registered legal address if different from salon

  // Email / SMTP settings — configured once in Admin Panel per deployment
  // Works with any SMTP provider: Gmail, Outlook, Hostinger, OVH, etc.
  smtpHost        String?           // e.g. "smtp.gmail.com"
  smtpPort        Int?     @default(587)     // 587 for STARTTLS, 465 for SSL
  smtpUser        String?           // sender login / email address
  smtpPass        String?           // App Password or SMTP password
  smtpFrom        String?           // display address e.g. "Salon Beauty <info@salon.pl>"
  smtpSecure      Boolean  @default(false)   // true = port 465 SSL, false = 587 STARTTLS

  // Social Login Settings
  googleClientId     String?
  googleClientSecret String?
  
  appleClientId      String?
  appleTeamId        String?
  appleKeyId         String?
  applePrivateKey    String?
  
  telegramBotToken   String?
  telegramBotUsername  String?

  // Separate interactive Telegram CLIENT BOOKING bot (own token, own toggle).
  // Do NOT confuse with telegramBotToken/telegramBotUsername above, which are
  // the one-way salon-notification bot.
  clientBotToken     String?
  clientBotUsername  String?
  clientBotSiteUrl   String?
  clientBotEnabled   Boolean  @default(false)

  notifEmailEnabled       Boolean  @default(false)
  notifTelegramEnabled    Boolean  @default(false)
  notifReminder24hEnabled Boolean  @default(false)
  notifReminder2hEnabled  Boolean  @default(false)

  enabledLocales  String   @default("[\"pl\",\"en\",\"uk\"]")
  homepageWidgetBlock String? // JSON: {"type":"photoWidget","config":{...}} — single block shown on the homepage

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Salon-side Telegram notification recipients (multi-recipient list, no relation —
// implicitly tenant-scoped since there's a single TenantConfig singleton).
model TelegramNotificationRecipient {
  id        String   @id @default(cuid())
  chatId    String
  label     String?
  createdAt DateTime @default(now())
}

model NotificationLog {
  id            String   @id @default(cuid())
  type          String   // BOOKING_CONFIRMATION | BOOKING_REMINDER_24H | BOOKING_REMINDER_2H | BOOKING_CANCELLATION | BOOKING_UPDATE | CONTACT_FORM
  channel       String   // email | telegram | telegram_client
  appointmentId String?
  recipientId   String?
  status        String   // sent | failed | skipped
  error         String?
  sentAt        DateTime @default(now())

  @@index([appointmentId, type])
}

// One-time-use token for password reset emails.
// Deleted immediately after use. Cascades when user is deleted.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Page {
  id         String   @id @default(cuid())
  ownerType  String   // 'global' | 'master'
  masterId   String?  // set when ownerType = 'master'
  slug       String
  title_pl   String?
  title_en   String?
  title_uk   String?
  enabled    Boolean  @default(true)
  order      Int      @default(0)
  visibility String?  // JSON string[] of page-types, e.g. ["home","booking"] — only meaningful when ownerType='global'

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  master     User?    @relation(fields: [masterId], references: [id], onDelete: Cascade)
  blocks     Block[]

  @@unique([ownerType, masterId, slug])
}

model Block {
  id        String   @id @default(cuid())
  pageId    String
  type      String   // 'photoWidget' | 'photoGallery' | 'text'
  order     Int      @default(0)
  config    String   // JSON, shape depends on type

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page      Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// NextAuth standardized Account model (required for OAuth linking)
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
